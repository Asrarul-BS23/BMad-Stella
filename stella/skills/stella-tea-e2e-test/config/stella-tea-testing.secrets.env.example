# Copy to {project-root}/_bmad/custom/stella-tea-testing.secrets.env and fill in.
# Gitignored. A dedicated name avoids collision with a project's own root .env.
# Keys are the password_env names from stella-tea-testing.user.toml.
# Resolution order at run time: this file -> OS environment variable -> ask the user.
QA_STAGING_ADMIN_PASSWORD=
QA_STAGING_CUSTOMER_PASSWORD=
